<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Historique de veille</title>
<meta name="description" content="{{ entries|length }} rapports de veille technologique">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232563eb'/%3E%3Ccircle cx='14' cy='14' r='7' fill='none' stroke='white' stroke-width='3'/%3E%3Cpath d='M19 19l6 6' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
<script>try { var t = localStorage.getItem("veille-theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}</script>
<style>
{% include "_theme.css" %}
main { max-width: 860px; margin: 0 auto; padding: 2rem var(--gutter); }
input[type=search] { width: 100%; font: inherit; padding: .5rem .7rem; border: 1px solid var(--border); border-radius: 8px; background: var(--card); color: var(--fg); margin: 1rem 0; }
ol { list-style: none; padding: 0; margin: 0; }
li { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: .9rem 1.1rem; margin-bottom: .8rem; }
li h2 { font-size: var(--step-1); display: flex; gap: .6rem; align-items: baseline; flex-wrap: wrap; }
.axes { display: flex; flex-wrap: wrap; gap: .35rem; margin: .5rem 0; }
li ul { margin: .3rem 0 0; padding-left: 1.1rem; font-size: var(--step--1); }
.hidden { display: none; }
</style>
</head>
<body>
<main>
  <h1>Historique de veille</h1>
  <p class="muted">{{ entries|length }} rapports · <a href="latest.html">dernier rapport</a></p>
  <input type="search" id="q" placeholder="Filtrer (date, sujet, axe)…" aria-label="Filtrer les rapports">
  <ol>
    {% for e in entries %}
    <li>
      <h2><a href="{{ e.file }}">{{ e.date }}</a> <span class="muted small">{{ e.kept }} articles · {{ e.model }}</span></h2>
      <div class="axes">
        {% for a in e.axes %}<span class="pill axis-color" style="--hue: {{ a.hue }}"><span class="dot"></span>{{ a.title }} {{ a.n }}</span>{% endfor %}
      </div>
      {% if e.top %}<ul>{% for t in e.top %}<li style="all:unset;display:list-item">{{ t }}</li>{% endfor %}</ul>{% endif %}
    </li>
    {% else %}
    <li class="muted">Aucun rapport.</li>
    {% endfor %}
  </ol>
</main>
<script>
(function () {
  var q = document.getElementById("q"), items = Array.prototype.slice.call(document.querySelectorAll("main > ol > li"));
  q.addEventListener("input", function () {
    var t = q.value.trim().toLowerCase();
    items.forEach(function (li) { li.classList.toggle("hidden", !!t && li.textContent.toLowerCase().indexOf(t) === -1); });
  });
})();
</script>
</body>
</html>
