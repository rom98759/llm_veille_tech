<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Veille du {{ date_long }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="Veille technologique — {{ date_long }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="article">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23111418'/%3E%3Ccircle cx='14' cy='14' r='7' fill='none' stroke='white' stroke-width='3'/%3E%3Cpath d='M19 19l6 6' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
<script>try { var t = localStorage.getItem("veille-theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}</script>
<style>
{% include "_theme.css" %}
/* Bandeau du rapport */
.hero { padding-block: 72px 20px; }
.hero-nav { display: flex; flex-wrap: wrap; gap: 8px 14px; align-items: center; font: 12px var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.hero-nav a { color: var(--muted); }
.hero h1 { font-size: clamp(38px, 5.5vw, 58px); line-height: 1.08; letter-spacing: -.015em; margin: 16px 0 10px; font-weight: 500; }
.hero h1::first-letter { text-transform: uppercase; }
.hero .sub { font: 16px var(--sans); color: var(--muted); margin: 0 0 90px; }
@media (max-width: 640px) { .hero .sub { margin-bottom: 56px; } }

/* L'essentiel */
.essential { padding-block: 0 0; margin-block: 8px 100px; }
.essential h2 { margin: 0 0 24px; }
.essential ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 28px; }
.essential li { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: baseline; }
.essential .txt { font-size: 22px; line-height: 1.5; flex: 1 1 420px; min-width: 260px; margin: 0; }
@media (max-width: 640px) { .essential .txt { font-size: 19px; } }
.essential .chips { display: flex; gap: 6px; flex-wrap: wrap; }
.chip { font: 600 12px var(--sans); color: var(--axis-ink); background: none; border: 1px solid var(--axis); border-radius: 999px; padding: 2px 9px; white-space: nowrap; opacity: .85; }
.chip:hover { text-decoration: none; opacity: 1; }

/* Mise en page */
.layout { display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; padding-bottom: 64px; }
.toc { flex: 1 1 240px; max-width: 280px; font-size: 14px; }
@media (min-width: 1100px) { .toc { position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow-y: auto; } }
@media (max-width: 1099px) { .toc { max-width: none; } }
.toc summary { list-style: none; cursor: pointer; margin: 8px 0 12px; }
.toc summary::-webkit-details-marker { display: none; }
.toc-axis { display: flex; align-items: center; gap: 8px; color: var(--fg); font-weight: 600; margin-top: 18px; }
.toc-axis small { color: var(--muted); font-weight: 400; font-size: 13px; }
.toc ol { list-style: none; margin: 4px 0 0; padding: 0 0 0 18px; }
.toc li a { display: block; color: var(--fg2); padding: 5px 0; line-height: 1.4; }
.content { flex: 999 1 560px; min-width: 0; max-width: 780px; }

/* Barre d'outils */
.toolbar { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 12px;
           background: var(--card); border: 1px solid var(--border); border-radius: 14px; margin-bottom: 36px; }
.toolbar input[type=search] { flex: 1 1 220px; min-width: 0; background: var(--bg); }
.toolbar label.inline { font-size: 14px; color: var(--muted); }
.toggles { display: flex; flex-wrap: wrap; gap: 6px; }
.toggle { height: 44px; padding: 0 14px; display: inline-flex; align-items: center; gap: 8px; border-radius: 999px; font: inherit;
          font-size: 14px; cursor: pointer; background: var(--card); color: var(--muted); border: 1px solid var(--border); }
.toggle[aria-pressed="true"] { background: var(--fg); color: var(--bg); border-color: var(--fg); }
.toolbar .count { font: 13px var(--mono); color: var(--muted); margin-left: auto; }
@media (min-width: 900px) { .toolbar { top: 8px; } }
@media (max-width: 899px) {
  .toolbar { position: static; }
  .toggles { flex-wrap: nowrap; overflow-x: auto; width: 100%; padding-bottom: 2px; }
  .toggle { flex: none; }
}

/* Sections d'axe */
section.axis-section { margin-bottom: 20px; scroll-margin-top: 150px; }
.axis-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin: 0 0 4px; }
.axis-head h2 { margin: 0; font-size: 42px; font-weight: 500; letter-spacing: -.015em; }
.axis-head .sans { font-size: 12px; color: var(--muted); }
.axis-bar { height: 3px; width: 56px; background: var(--axis); border-radius: 2px; margin-bottom: 52px; }
.synthesis { font-size: 18px; line-height: 1.7; margin: 0 0 28px; color: var(--fg2); }
a.cite { font: 600 12px var(--sans); vertical-align: 2px; border: 1px solid var(--border); border-radius: 999px; padding: 1px 7px;
         color: var(--axis-ink); background: var(--card); margin: 0 1px; }
a.cite:hover { border-color: var(--axis); text-decoration: none; }

/* Fiche article : séparée, numérotée, lecture d'abord */
.card { display: flex; flex-wrap: wrap; gap: 20px 40px; padding: 76px 0 76px 26px; border-left: 3px solid var(--axis);
        scroll-margin-top: 150px; }
@media (max-width: 640px) { .card { padding: 48px 0 48px 18px; gap: 14px 28px; } }
.card:target { outline: 2px solid var(--axis); outline-offset: 6px; }
.card-rail { flex: 0 0 110px; }
.card-rail .num { font: 300 60px/1 var(--serif); letter-spacing: -.03em; color: var(--axis); opacity: .3; }
@media (max-width: 640px) { .card-rail { flex-basis: auto; } .card-rail .num { font-size: 36px; } }
.card-body { flex: 1 1 500px; min-width: 280px; }
.card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font: 600 13px var(--sans); color: var(--muted); margin-bottom: 18px; }
.card-meta .src { color: var(--fg); }
.card-meta .cov { color: var(--axis-ink); }
.card-meta .warn { background: var(--warn-bg); color: var(--warn-fg); border-radius: 6px; padding: 0 6px; }
.card h3 { margin: 0 0 14px; font-size: 32px; line-height: 1.2; letter-spacing: -.012em; font-weight: 500; }
@media (max-width: 640px) { .card h3 { font-size: 24px; } }
.card h3 a { color: var(--fg); }
.card h3 a:hover { color: var(--muted); }
.lead { font-size: 19px; line-height: 1.6; font-weight: 600; margin: 0 0 20px; color: var(--fg); max-width: 620px; }
.more { margin-top: 6px; }
.more > summary { cursor: pointer; list-style: none; font: 600 14px var(--sans); color: var(--axis-ink); }
.more > summary::-webkit-details-marker { display: none; }
.more > summary::before { content: "Lire le résumé complet ↓"; }
.more[open] > summary { margin-bottom: 20px; }
.more[open] > summary::before { content: "Replier ↑"; color: var(--muted); }
.summary { font-size: 16.5px; line-height: 1.8; color: var(--fg2); max-width: 620px; }
.summary p { margin: 0 0 12px; }
.points { margin: 4px 0 20px; padding-left: 20px; color: var(--fg2); font-size: 16px; max-width: 600px; }
.points li { margin: 6px 0; }
.points li::marker { color: var(--axis-ink); }
.matters { background: color-mix(in srgb, var(--axis) var(--tint), var(--card)); border-radius: 10px; padding: 14px 16px; margin: 0 0 20px; font-size: 16px; max-width: 600px; }
.matters .eyebrow { color: var(--axis-ink); margin-bottom: 2px; font-size: 11px; }
.card-foot { display: flex; flex-wrap: wrap; gap: 10px 20px; align-items: center; font-size: 14px; }
.card-foot .original { font: 600 14px var(--sans); color: var(--axis-ink); }
.tag { height: 32px; padding: 0 12px; border: 1px solid var(--border); border-radius: 999px; background: var(--card); font: inherit;
       font-size: 13px; color: var(--fg2); cursor: pointer; }
.tag:hover { border-color: var(--muted); }
.card-foot .crit { font: 12px var(--sans); color: var(--muted); }
.card-foot .spacer { flex: 1; }
.related { margin-top: 12px; font-size: 14px; display: flex; flex-wrap: wrap; gap: 4px 14px; }

/* Liens écartés */
.others { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 4px 20px; }
.others summary { cursor: pointer; padding: 12px 0; font-size: 15px; color: var(--muted); }
.others ol { list-style: none; margin: 0; padding: 0 0 8px; }
.other { padding: 12px 0; border-top: 1px solid var(--border); }
.other .t { font-weight: 500; }
.other .m { font: 12px var(--mono); color: var(--muted); }
.other .reason { margin: 3px 0 0; font-size: 14px; color: var(--muted); cursor: pointer;
                 display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.other .reason.open { -webkit-line-clamp: unset; display: block; }
.empty { color: var(--muted); font-style: italic; }
.hidden { display: none !important; }
#top { position: fixed; right: 16px; bottom: 16px; opacity: 0; pointer-events: none; transition: opacity .2s; font-size: 14px; width: auto; padding: 0 14px; }
#top.show { opacity: 1; pointer-events: auto; }

@media print {
  :root { --bg: #fff; --card: #fff; --fg: #000; --fg2: #111; }
  .site-header, .toolbar, .toc, #top, .site-footer .links { display: none !important; }
  .card { break-inside: avoid; }
  .more > summary { display: none; }
  section.axis-section + section.axis-section { break-before: page; }
  .card h3 a::after, .other a::after { content: " (" attr(href) ")"; font: 11px var(--mono); color: #555; word-break: break-all; }
  .other .reason { -webkit-line-clamp: unset; display: block; }
}
</style>
</head>
<body>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="index.html">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="7.5"/><path d="M17.5 17.5L24 24"/><path d="M8.5 12h7M12 8.5v7"/></svg>
      Veille <span class="tag">local</span>
    </a>
    <nav class="site-nav" aria-label="Navigation principale">
      <a href="latest.html" aria-current="page">Dernier rapport</a>
      <a href="index.html">Historique</a>
      <button class="icon-btn" id="theme" type="button" aria-label="Basculer le thème clair ou sombre">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M10 3a7 7 0 0 0 0 14z" fill="currentColor"/></svg>
      </button>
    </nav>
  </div>
</header>

<section class="hero wrap">
  <div class="hero-nav">
    {% if prev %}<a href="{{ prev }}">← rapport précédent</a>{% endif %}
    {% if number %}<span>Rapport n° {{ number }}</span><span aria-hidden="true">·</span>{% endif %}
    <span>du {{ since_label }} au {{ until_label }}</span>
  </div>
  <h1>{{ date_long }}</h1>
  <p class="sub">{{ total_kept }} articles retenus sur {{ total_collected }} collectés, {{ sources|length }} sources — modèle {{ model }}</p>
</section>

{% if exec_items %}
<section class="wrap" aria-labelledby="ess-title">
  <div class="essential">
    <h2 id="ess-title" class="sans eyebrow">L'essentiel</h2>
    <ol>
      {% for e in exec_items %}
      <li><span class="txt">{{ e.html }}</span>
        {% if e.cites %}<span class="chips">{% for c in e.cites %}<a class="chip" href="{{ c.href }}" title="{{ c.title }}" style="--axis: {{ c.color }}">{{ c.label }}</a>{% endfor %}</span>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </div>
</section>
{% endif %}

<div class="wrap layout">
  <aside class="toc" aria-label="Sommaire">
    <details open>
      <summary class="eyebrow">Sommaire</summary>
      {% for a in axes %}
      <a class="toc-axis axis" href="#{{ a.key }}" style="--axis: {{ a.color }}"><span class="swatch"></span>{{ a.title }} <small>{{ a["items"]|length }}</small></a>
      <ol>
        {% for it in a["items"] %}<li><a href="#{{ it.anchor }}">{{ it.title }}</a></li>{% endfor %}
      </ol>
      {% endfor %}
    </details>
  </aside>

  <main class="content">
    <form class="toolbar" role="search" onsubmit="return false">
      <label for="q" class="sr-only">Rechercher dans le rapport</label>
      <input id="q" class="field" type="search" placeholder="Rechercher : titre, résumé, source, tag…">
      <label for="src" class="sr-only">Source</label>
      <select id="src" class="field">
        <option value="">Toutes les sources</option>
        {% for s in sources %}<option>{{ s }}</option>{% endfor %}
      </select>
      <label for="min" class="inline">Pertinence</label>
      <select id="min" class="field">
        <option value="0">toutes</option><option value="7">≥ 7</option><option value="9">≥ 9</option>
      </select>
      <div class="toggles" role="group" aria-label="Axes affichés">
        {% for a in axes %}
        <button type="button" class="toggle axis" data-axis-toggle="{{ a.key }}" aria-pressed="true" style="--axis: {{ a.color }}"><span class="swatch"></span>{{ a.title }}</button>
        {% endfor %}
      </div>
      <span class="count" id="count" aria-live="polite"></span>
    </form>

    {% for a in axes %}
    <section class="axis-section axis" id="{{ a.key }}" data-axis="{{ a.key }}" aria-labelledby="{{ a.key }}-title" style="--axis: {{ a.color }}">
      <div class="axis-head">
        <h2 id="{{ a.key }}-title">{{ a.title }}</h2>
        <span class="sans">{{ a["items"]|length }} retenus · {{ a.others|length }} écartés · {{ a.total_collected }} collectés</span>
      </div>
      <div class="axis-bar"></div>
      {% if a.synthesis %}<p class="synthesis">{{ a.synthesis_html }}</p>{% else %}<p class="empty">Rien de notable sur la période.</p>{% endif %}

      {% for it in a["items"] %}
      <article class="card" id="{{ it.anchor }}" data-axis="{{ a.key }}" data-score="{{ it.llm_score }}" data-source="{{ it.source }}">
        <div class="card-rail"><span class="num">{{ "%02d"|format(loop.index) }}</span></div>
        <div class="card-body">
          <h3><a href="{{ it.url }}" rel="noopener">{{ it.title }}</a></h3>
          <div class="card-meta">
            <span class="src">{{ it.source }}</span>
            <time datetime="{{ it.published }}">{{ it.published[:10] }}</time>
            {% if it.coverage and it.coverage > 1 %}<span class="cov" title="{{ it.coverage }} sources couvrent ce sujet">{{ it.coverage }} sources sur ce sujet</span>{% endif %}
            {% if it.digest.text_source == "rss" %}<span class="warn" title="La page n'a pas pu être lue : résumé fait sur l'extrait du flux, moins complet">résumé sur extrait RSS</span>{% endif %}
          </div>
          {% if it.digest.tldr %}<p class="lead">{{ it.digest.tldr|md_inline }}</p>{% endif %}
          <details class="more">
            <summary></summary>
            {% if it.digest.summary %}<div class="summary">{{ it.digest.summary|md_block }}</div>{% endif %}
            {% if it.digest.key_points %}<ul class="points">{% for p in it.digest.key_points %}<li>{{ p|md_inline }}</li>{% endfor %}</ul>{% endif %}
            {% if it.digest.why_it_matters %}<div class="matters"><div class="eyebrow">Pourquoi c'est important</div>{{ it.digest.why_it_matters|md_inline }}</div>{% endif %}
            {% if it.related %}
            <div class="related"><span class="muted">Voir aussi :</span>{% for r in it.related %}<a href="{{ r.url }}" rel="noopener" title="{{ r.title }}">{{ r.source }}</a>{% endfor %}</div>
            {% endif %}
            <div class="card-foot">
              <a class="original" href="{{ it.url }}" rel="noopener">Voir l'article original ↗</a>
              {% for t in it.digest.tags %}<button type="button" class="tag" data-tag="{{ t }}">#{{ t }}</button>{% endfor %}
              <span class="spacer"></span>
              {% if it.criteria_labels %}<span class="crit" title="Critères validés par la grille de notation">{{ it.criteria_labels|join(" · ") }}</span>{% endif %}
              {% if it.cited_from %}<a href="#{{ it.cited_from }}">↑ synthèse</a>{% endif %}
            </div>
          </details>
        </div>
      </article>
      {% endfor %}

      {% if a.others %}
      <details class="others">
        <summary>{{ a.others|length }} autres articles évalués et écartés</summary>
        <ol>
          {% for it in a.others %}
          <li class="other" data-axis="{{ a.key }}" data-score="{{ it.llm_score }}" data-source="{{ it.source }}">
            <a class="t" href="{{ it.url }}" rel="noopener">{{ it.title }}</a>
            <div class="m">{{ it.source }} · {{ it.published[:10] }} · {{ it.llm_score|fmt_score }}/10</div>
            {% if it.llm_reason %}<p class="reason" title="Cliquer pour tout afficher">{{ it.llm_reason }}</p>{% endif %}
          </li>
          {% endfor %}
        </ol>
      </details>
      {% endif %}
    </section>
    {% endfor %}
  </main>
</div>

<footer class="site-footer">
  <div class="wrap">
    <span>Généré localement le {{ generated_at[:10] }} à {{ generated_at[11:16] }} UTC · aucune donnée envoyée hors du lab</span>
    <span class="links"><a href="{{ files.md }}">Version Markdown</a><a href="{{ files.json }}">Données JSON</a></span>
  </div>
</footer>
<button type="button" id="top" class="icon-btn" aria-label="Retour en haut">↑ Haut</button>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var root = document.documentElement;
  if (innerWidth < 1100) $(".toc details").open = false;

  $("#theme").addEventListener("click", function () {
    var dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    root.dataset.theme = dark ? "light" : "dark";
    try { localStorage.setItem("veille-theme", root.dataset.theme); } catch (e) {}
  });

  var rtf = window.Intl && Intl.RelativeTimeFormat ? new Intl.RelativeTimeFormat("fr", { numeric: "auto" }) : null;
  $$("time[datetime]").forEach(function (t) {
    var h = (Date.parse(t.getAttribute("datetime")) - Date.now()) / 36e5;
    if (!rtf || isNaN(h)) return;
    t.title = t.textContent;
    t.textContent = Math.abs(h) < 24 ? rtf.format(Math.round(h), "hour") : rtf.format(Math.round(h / 24), "day");
  });

  var q = $("#q"), min = $("#min"), src = $("#src"), count = $("#count"), axesOn = {};
  $$("[data-axis-toggle]").forEach(function (b) { axesOn[b.dataset.axisToggle] = true; });
  function apply() {
    var text = q.value.trim().toLowerCase(), m = parseFloat(min.value) || 0, s = src.value, shown = 0, total = 0;
    $$(".card, .other").forEach(function (el) {
      var ok = axesOn[el.dataset.axis] && (parseFloat(el.dataset.score) || 0) >= m && (!s || el.dataset.source === s)
               && (!text || el.textContent.toLowerCase().indexOf(text) !== -1);
      el.classList.toggle("hidden", !ok);
      if (el.classList.contains("card")) { total++; if (ok) shown++; }
    });
    $$("section.axis-section").forEach(function (sec) { sec.classList.toggle("hidden", !axesOn[sec.dataset.axis]); });
    count.textContent = shown === total ? total + " articles" : shown + " / " + total + " articles";
  }
  [q, min, src].forEach(function (el) { el.addEventListener("input", apply); el.addEventListener("change", apply); });
  $$("[data-axis-toggle]").forEach(function (b) {
    b.addEventListener("click", function () {
      var k = b.dataset.axisToggle; axesOn[k] = !axesOn[k];
      b.setAttribute("aria-pressed", String(axesOn[k])); apply();
    });
  });
  $$("[data-tag]").forEach(function (b) { b.addEventListener("click", function () { q.value = b.dataset.tag; apply(); q.focus(); }); });
  apply();

  $$(".other .reason").forEach(function (p) { p.addEventListener("click", function () { p.classList.toggle("open"); }); });
  var top = $("#top");
  top.addEventListener("click", function () { scrollTo(0, 0); });
  addEventListener("scroll", function () { top.classList.toggle("show", scrollY > 700); }, { passive: true });
  addEventListener("beforeprint", function () { $$("details").forEach(function (d) { d.open = true; }); });
})();
</script>
</body>
</html>
