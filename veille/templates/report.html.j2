<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Veille {{ date }}</title>
<meta name="description" content="{{ description }}">
<meta property="og:title" content="Veille technologique — {{ date }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="article">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%232563eb'/%3E%3Ccircle cx='14' cy='14' r='7' fill='none' stroke='white' stroke-width='3'/%3E%3Cpath d='M19 19l6 6' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E">
<script>try { var t = localStorage.getItem("veille-theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}</script>
<style>
{% include "_theme.css" %}
.layout { max-width: 1240px; margin: 0 auto; padding: 0 var(--gutter); }
header.top { padding: 2rem 0 1rem; display: flex; gap: 1rem; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; }
.stats { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .6rem; }
.stat { background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: .35rem .8rem; font-size: var(--step--1); }
.stat b { font-size: var(--step-1); margin-right: .25em; }
.top-actions { display: flex; gap: .5rem; }
.btn { background: var(--card); color: var(--fg); border: 1px solid var(--border); border-radius: 8px; padding: .4rem .7rem; cursor: pointer; font: inherit; font-size: var(--step--1); }

.grid { display: grid; gap: 2rem; grid-template-columns: minmax(0, 1fr); }
@media (min-width: 1100px) { .grid { grid-template-columns: 260px minmax(0, 1fr); } }
aside.toc { font-size: var(--step--1); }
@media (min-width: 1100px) { aside.toc { position: sticky; top: 1rem; align-self: start; max-height: calc(100vh - 2rem); overflow-y: auto; } }
@media (max-width: 1099px) { aside.toc details:not([open]) > :not(summary) { display: none; } }
aside.toc summary { cursor: pointer; font-weight: 600; margin-bottom: .4rem; }
aside.toc ol { list-style: none; padding: 0; margin: 0 0 1rem; }
aside.toc li a { display: flex; gap: .5rem; align-items: baseline; color: var(--fg); padding: .2rem 0; }
aside.toc li a span:last-child { overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
aside.toc .toc-axis { display: flex; gap: .45rem; align-items: center; font-weight: 600; margin: .8rem 0 .3rem; color: var(--fg); }
aside.toc .n { color: var(--muted); font-variant-numeric: tabular-nums; min-width: 1.6rem; }

main { min-width: 0; }
.content { max-width: 75ch; }
.toolbar { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: .6rem 0; border-bottom: 1px solid var(--border);
           display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; margin-bottom: 1.5rem; }
.toolbar input[type=search], .toolbar select { font: inherit; font-size: var(--step--1); padding: .4rem .6rem; border: 1px solid var(--border);
           border-radius: 8px; background: var(--card); color: var(--fg); }
.toolbar input[type=search] { flex: 1 1 14rem; min-width: 0; }
.toolbar label { display: inline-flex; align-items: center; gap: .4rem; font-size: var(--step--1); color: var(--muted); }
.toolbar .count { font-size: var(--step--1); color: var(--muted); margin-left: auto; }

.exec { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; margin-bottom: 2rem; }
.exec h2 { font-size: var(--step-1); margin-bottom: .4rem; }
.exec ul { margin: 0; padding-left: 1.2rem; } .exec li { margin: .3rem 0; }

section.axis { margin: 0 0 3rem; scroll-margin-top: 7.5rem; }
.axis-head { display: flex; align-items: center; gap: .6rem; padding-bottom: .5rem; border-bottom: 3px solid var(--axis); margin-bottom: 1rem; }
.axis-head .desc { margin-left: auto; text-align: right; }
.synthesis { font-size: var(--step-0); margin: 0 0 1.5rem; }
a.cite { display: inline-block; font-size: .72em; line-height: 1; vertical-align: super; padding: .2em .45em; margin: 0 .1em;
         border-radius: 999px; background: var(--soft); border: 1px solid var(--border); color: var(--muted); font-weight: 600; text-decoration: none; }
a.cite:hover, a.cite:focus-visible { color: var(--fg); border-color: var(--axis, var(--accent)); }

.card { background: var(--card); border: 1px solid var(--border); border-left: 3px solid var(--axis); border-radius: var(--radius);
        padding: 1rem 1.25rem; margin: 0 0 1rem; scroll-margin-top: 7.5rem; transition: box-shadow .15s; }
.card:hover { box-shadow: 0 4px 18px rgb(0 0 0 / .07); }
.card:target { outline: 2px solid var(--axis); }
.card header { display: flex; gap: .8rem; align-items: flex-start; }
.card .meta { display: flex; flex-wrap: wrap; gap: .35rem .6rem; align-items: center; margin-top: .3rem; font-size: var(--step--1); color: var(--muted); }
.card .src { font-weight: 600; color: var(--fg); }
.coverage { color: var(--fg); border-color: var(--axis); }
.tldr { font-size: var(--step-1); line-height: 1.5; margin: .8rem 0 .5rem; }
.points { margin: 0 0 .6rem; padding-left: 1.2rem; } .points li { margin: .15rem 0; }
.matters { background: var(--soft); border-radius: 8px; padding: .55rem .8rem; margin: .6rem 0; font-size: var(--step--1); }
.matters b { display: block; font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); }
.warn { background: var(--warn-bg); color: var(--warn-fg); border-color: transparent; }
.card footer { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; margin-top: .6rem; }
.card footer .spacer { flex: 1; }
.related { font-size: var(--step--1); margin-top: .4rem; }

.others { margin-top: 1.5rem; }
.others summary { cursor: pointer; color: var(--muted); font-size: var(--step--1); padding: .4rem 0; }
.others ol { list-style: none; padding: 0; margin: .4rem 0 0; }
.other { display: flex; gap: .7rem; padding: .55rem 0; border-top: 1px solid var(--border); }
.other .body { min-width: 0; }
.other .reason { margin: .15rem 0 0; font-size: var(--step--1); color: var(--muted); cursor: pointer;
                 display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.other .reason.open { -webkit-line-clamp: unset; display: block; }

.hidden { display: none !important; }
#top { position: fixed; right: 1rem; bottom: 1rem; opacity: 0; pointer-events: none; transition: opacity .2s; }
#top.show { opacity: 1; pointer-events: auto; }
.empty { color: var(--muted); font-style: italic; }

@media print {
  :root { --bg: #fff; --card: #fff; --soft: #f5f5f4; --fg: #000; }
  .toolbar, aside.toc, .top-actions, #top { display: none !important; }
  .grid { display: block; } .content { max-width: none; }
  .card { break-inside: avoid; box-shadow: none; }
  section.axis + section.axis { break-before: page; }
  .card h3 a[href^="http"]::after, .other a[href^="http"]::after { content: " (" attr(href) ")"; font-size: .75em; color: #555; word-break: break-all; }
  .other .reason { -webkit-line-clamp: unset; display: block; }
}
</style>
</head>
<body>
<div class="layout">
  <header class="top">
    <div>
      <h1>Veille technologique — {{ date }}</h1>
      <div class="stats">
        <span class="stat"><b>{{ total_kept }}</b>retenus</span>
        <span class="stat"><b>{{ total_collected }}</b>collectés</span>
        <span class="stat">depuis <b>{{ since[:10] }}</b></span>
        <span class="stat">modèle <code>{{ model }}</code></span>
      </div>
    </div>
    <div class="top-actions">
      <a class="btn" href="index.html">Historique</a>
      <button class="btn" id="theme" type="button" aria-label="Changer de thème">◐ Thème</button>
    </div>
  </header>

  <div class="grid">
    <aside class="toc" aria-label="Sommaire">
      <details open>
        <summary>Sommaire</summary>
        {% for a in axes %}
        <a class="toc-axis axis-color" style="--hue: {{ a.hue }}" href="#{{ a.key }}"><span class="dot"></span>{{ a.title }} <span class="muted">({{ a["items"]|length }})</span></a>
        <ol>
          {% for it in a["items"] %}
          <li><a href="#{{ it.anchor }}"><span class="n">{{ it.llm_score|fmt_score }}</span><span>{{ it.title }}</span></a></li>
          {% endfor %}
        </ol>
        {% endfor %}
      </details>
    </aside>

    <main>
      <div class="content">
        <div class="toolbar" role="search">
          <input type="search" id="q" placeholder="Rechercher (titre, résumé, source, tag)…" aria-label="Rechercher">
          <label>score ≥ <input type="range" id="min" min="0" max="10" step="0.5" value="0" aria-label="Score minimum"> <output id="minv">0</output></label>
          <select id="src" aria-label="Filtrer par source">
            <option value="">Toutes sources</option>
            {% for s in sources %}<option>{{ s }}</option>{% endfor %}
          </select>
          {% for a in axes %}
          <button type="button" class="pill axis-color" style="--hue: {{ a.hue }}" data-axis-toggle="{{ a.key }}" aria-pressed="true"><span class="dot"></span>{{ a.title }}</button>
          {% endfor %}
          <span class="count" id="count" aria-live="polite"></span>
        </div>

        {% if executive_html %}
        <section class="exec">
          <h2>Résumé exécutif</h2>
          {{ executive_html }}
        </section>
        {% endif %}

        {% for a in axes %}
        <section class="axis axis-color" id="{{ a.key }}" data-axis="{{ a.key }}" style="--hue: {{ a.hue }}">
          <div class="axis-head">
            <span class="dot"></span><h2>{{ a.title }}</h2>
            <span class="desc muted small">{{ a.description }}<br>{{ a["items"]|length }} retenus · {{ a.others|length }} écartés · {{ a.total_collected }} collectés</span>
          </div>
          {% if a.synthesis %}<p class="synthesis">{{ a.synthesis_html }}</p>{% else %}<p class="empty">Rien de notable sur la période.</p>{% endif %}

          {% for it in a["items"] %}
          <article class="card" id="{{ it.anchor }}" data-axis="{{ a.key }}" data-score="{{ it.llm_score }}" data-source="{{ it.source }}">
            <header>
              <span class="score score--{{ it.llm_score|score_class }}" title="Pertinence {{ it.llm_score|fmt_score }}/10">{{ it.llm_score|fmt_score }}</span>
              <div>
                <h3><a href="{{ it.url }}" rel="noopener">{{ it.title }}</a></h3>
                <div class="meta">
                  <span class="src">{{ it.source }}</span>
                  <time datetime="{{ it.published }}">{{ it.published[:10] }}</time>
                  {% if it.coverage and it.coverage > 1 %}<span class="pill coverage" title="{{ it.coverage }} sources couvrent ce sujet">{{ it.coverage }} sources</span>{% endif %}
                  {% if it.digest.text_source == "rss" %}<span class="pill warn" title="La page n'a pas pu être lue : résumé fait sur l'extrait du flux, moins fiable">résumé sur extrait RSS</span>{% endif %}
                </div>
              </div>
            </header>
            {% if it.digest.tldr %}<p class="tldr">{{ it.digest.tldr|md_inline }}</p>{% endif %}
            {% if it.digest.key_points %}<ul class="points">{% for p in it.digest.key_points %}<li>{{ p|md_inline }}</li>{% endfor %}</ul>{% endif %}
            {% if it.digest.why_it_matters %}<div class="matters"><b>Pourquoi c'est important</b>{{ it.digest.why_it_matters|md_inline }}</div>{% endif %}
            {% if it.related %}
            <div class="related muted">Voir aussi : {% for r in it.related %}<a href="{{ r.url }}" rel="noopener" title="{{ r.title }}">{{ r.source }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>
            {% endif %}
            <footer>
              {% for t in it.digest.tags %}<button type="button" class="pill" data-tag="{{ t }}">#{{ t }}</button>{% endfor %}
              {% for c in it.criteria_labels %}<span class="pill" title="Critère de la grille de notation">✓ {{ c }}</span>{% endfor %}
              <span class="spacer"></span>
              {% if it.cited_from %}<a class="small" href="#{{ it.cited_from }}">↑ cité dans la synthèse</a>{% endif %}
            </footer>
          </article>
          {% endfor %}

          {% if a.others %}
          <details class="others">
            <summary>Autres liens évalués ({{ a.others|length }}) — écartés, avec la raison</summary>
            <ol>
              {% for it in a.others %}
              <li class="other" data-axis="{{ a.key }}" data-score="{{ it.llm_score }}" data-source="{{ it.source }}">
                <span class="score score--sm score--{{ it.llm_score|score_class }}">{{ it.llm_score|fmt_score }}</span>
                <div class="body">
                  <a href="{{ it.url }}" rel="noopener">{{ it.title }}</a> <span class="muted small">· {{ it.source }} · {{ it.published[:10] }}</span>
                  {% if it.llm_reason %}<p class="reason" title="Cliquer pour tout afficher">{{ it.llm_reason }}</p>{% endif %}
                </div>
              </li>
              {% endfor %}
            </ol>
          </details>
          {% endif %}
        </section>
        {% endfor %}
      </div>
    </main>
  </div>
</div>
<a href="#" id="top" class="btn" aria-label="Retour en haut">↑ Haut</a>

<script>
(function () {
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var root = document.documentElement;
  if (innerWidth < 1100) $("aside.toc details").open = false;  // sommaire replié sur petit écran

  // Thème : clair / sombre / système, mémorisé si le stockage est disponible.
  $("#theme").addEventListener("click", function () {
    var dark = root.dataset.theme ? root.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    root.dataset.theme = dark ? "light" : "dark";
    try { localStorage.setItem("veille-theme", root.dataset.theme); } catch (e) {}
  });

  // Dates relatives.
  var rtf = window.Intl && Intl.RelativeTimeFormat ? new Intl.RelativeTimeFormat("fr", { numeric: "auto" }) : null;
  $$("time[datetime]").forEach(function (t) {
    var h = (Date.parse(t.getAttribute("datetime")) - Date.now()) / 36e5;
    if (!rtf || isNaN(h)) return;
    t.title = t.textContent;
    t.textContent = Math.abs(h) < 24 ? rtf.format(Math.round(h), "hour") : rtf.format(Math.round(h / 24), "day");
  });

  // Filtres.
  var q = $("#q"), min = $("#min"), minv = $("#minv"), src = $("#src"), count = $("#count");
  var axesOn = {};
  $$("[data-axis-toggle]").forEach(function (b) { axesOn[b.dataset.axisToggle] = true; });
  function apply() {
    var text = q.value.trim().toLowerCase(), m = parseFloat(min.value), s = src.value, shown = 0, total = 0;
    minv.textContent = min.value;
    $$(".card, .other").forEach(function (el) {
      var ok = axesOn[el.dataset.axis] && (parseFloat(el.dataset.score) || 0) >= m && (!s || el.dataset.source === s)
               && (!text || el.textContent.toLowerCase().indexOf(text) !== -1);
      el.classList.toggle("hidden", !ok);
      if (el.classList.contains("card")) { total++; if (ok) shown++; }
    });
    $$("section.axis").forEach(function (sec) { sec.classList.toggle("hidden", !axesOn[sec.dataset.axis]); });
    count.textContent = shown === total ? total + " articles" : shown + " / " + total + " articles";
  }
  [q, min, src].forEach(function (el) { el.addEventListener("input", apply); });
  $$("[data-axis-toggle]").forEach(function (b) {
    b.addEventListener("click", function () {
      var k = b.dataset.axisToggle; axesOn[k] = !axesOn[k];
      b.setAttribute("aria-pressed", String(axesOn[k])); apply();
    });
  });
  $$("[data-tag]").forEach(function (b) {
    b.addEventListener("click", function () { q.value = b.dataset.tag; apply(); q.focus(); });
  });
  apply();

  // Raison complète au clic, retour en haut, impression avec tout déplié.
  $$(".other .reason").forEach(function (p) { p.addEventListener("click", function () { p.classList.toggle("open"); }); });
  var top = $("#top");
  addEventListener("scroll", function () { top.classList.toggle("show", scrollY > 700); }, { passive: true });
  addEventListener("beforeprint", function () { $$("details").forEach(function (d) { d.open = true; }); });
})();
</script>
</body>
</html>
